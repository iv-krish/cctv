# CCTV Dashboard Environment Configuration

# Dashboard Web Port
PORT=3000

# Dashboard Login Credentials
# CHANGE ADMIN_PASS to your own strong password (at least 8 characters)
ADMIN_USER=admin
ADMIN_PASS=CHANGE_THIS_TO_YOUR_PASSWORD

# Security Tokens (Generated automatically)
SESSION_SECRET=a_long_random_secret_at_least_32_characters
DETECTOR_TOKEN=a_long_random_secret_at_least_32_characters

# Internal Service URLs (127.0.0.1 for local security)
DASHBOARD_URL=http://127.0.0.1:3000
GO2RTC_API_URL=http://127.0.0.1:1984
GO2RTC_RTSP_URL=rtsp://127.0.0.1:8554

# Event Storage Limit
MAX_EVENTS=500

# AI Detection Settings
DETECTOR_INTERVAL_SEC=2
YOLO_MODEL=models/yolov8n.pt
YOLO_IMG_SIZE=640
YOLO_CONFIDENCE=0.45

# WhatsApp Alert Configuration (Leave blank if not used)
# See WHATSAPP_SETUP.md for setup instructions
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_PHONE=

# Email Alert Configuration (SMTP) (Leave blank if not used)
# See EMAIL_SETUP.md for setup instructions
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
